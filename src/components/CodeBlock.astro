---
import Icon from './Icon.astro';
import { docsUi } from '../data/docs';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
  code: string;
}

const { locale, code } = Astro.props;
---

<div class="code-block">
  <code>{code}</code>
  <button class="copy-button" type="button" data-copy={code} aria-label={docsUi.copy[locale]}>
    <span class="copy-ic"><Icon name="copy" size={16} /></span>
    <span class="copy-ic check" aria-hidden="true"><Icon name="check" size={16} /></span>
  </button>
</div>
