---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<span class="brand-mark" aria-hidden="true">
  <i></i><i></i><b></b>
</span>
{!compact && <span class="brand-name">Engineering Flow</span>}

<style>
  .brand-mark { position: relative; display: inline-block; width: 34px; height: 26px; flex: 0 0 auto; }
  .brand-mark i { position: absolute; top: 4px; width: 15px; height: 15px; border: solid currentColor; border-width: 3px 3px 0 0; }
  .brand-mark i:first-child { left: 3px; transform: rotate(-135deg); }
  .brand-mark i:nth-child(2) { right: 3px; transform: rotate(45deg); }
  .brand-mark b { position: absolute; right: 2px; bottom: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--green); }
  .brand-name { font-size: 1.28rem; font-weight: 760; letter-spacing: -0.035em; white-space: nowrap; }
</style>
