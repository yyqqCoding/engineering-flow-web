---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Engineering Flow</title>
  </head>
  <body class="locale-entry">
    <main>
      <span class="entry-mark">&lt; · &gt;</span>
      <h1>Engineering Flow</h1>
      <p>Choose a language / 选择语言</p>
      <nav>
        <a href="/en">English</a>
        <a href="/zh-CN">简体中文</a>
      </nav>
    </main>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('engineering-flow-locale');
        const locale = saved === 'en' || saved === 'zh-CN'
          ? saved
          : navigator.language.toLowerCase().startsWith('zh') ? 'zh-CN' : 'en';
        location.replace(`/${locale}`);
      })();
    </script>
  </body>
</html>

<style>
  .locale-entry { min-height: 100vh; display: grid; place-items: center; text-align: center; }
  .locale-entry main { padding: 40px; }
  .entry-mark { color: var(--green); font-family: var(--mono); font-weight: 800; }
  .locale-entry h1 { margin: 10px 0; font-size: 2.5rem; }
  .locale-entry p { color: var(--muted); }
  .locale-entry nav { display: flex; justify-content: center; gap: 10px; margin-top: 25px; }
  .locale-entry a { padding: 10px 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
</style>
