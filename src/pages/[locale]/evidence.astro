---
import Icon from '../../components/Icon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, githubUrl, scenarioSnapshot, snapshotMeta, type Locale } from '../../data/site';
import { evidencePage } from '../../data/evidence';
import { locales } from '../../lib/routes.mjs';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale];
const d = evidencePage;
const percent = (value: number, total: number) => `${Math.round((value / total) * 1000) / 10}%`;
---

<SiteLayout locale={locale} title={t.evidencePage.title} description={d.lede[locale]} active="evidence" wide>
  <header class="page-heading">
    <div>
      <p class="eyebrow">{t.evidencePage.eyebrow}</p>
      <h1>{t.evidencePage.title}</h1>
      <p class="lede">{d.lede[locale]}</p>
    </div>
    <div class="source-stamp">
      <span><small>{t.evidencePage.snapshot}</small><b class="mono">v{snapshotMeta.version} · {snapshotMeta.sourceCommit}</b></span>
      <span><small>{t.evidencePage.updated}</small><b class="mono">{snapshotMeta.generatedAt}</b></span>
    </div>
  </header>

  <section class="ev-section" aria-labelledby="method">
    <h2 id="method">{d.methodTitle[locale]}</h2>
    <p class="section-lede">{d.methodIntro[locale]}</p>
    <ol class="method-rail">
      {d.methodSteps.map((step, index) => (
        <li class="reveal" data-reveal-step={index}>
          <header>
            <span class="method-icon"><Icon name={step.icon} size={19} /></span>
            <span class="method-num">{String(index + 1).padStart(2, '0')}</span>
          </header>
          <h3>{step.title[locale]}</h3>
          <p>{step.detail[locale]}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="ev-section" aria-labelledby="results">
    <h2 id="results">{d.compareTitle[locale]}</h2>
    <p class="section-lede">{d.compareIntro[locale]}</p>

    <div class="compare panel-flat">
      <div class="compare-legend">
        <span class="key without"><i></i>{d.withoutLabel[locale]}</span>
        <span class="key with"><i></i>{d.withLabel[locale]}</span>
      </div>
      {d.pluginResults.map((row, index) => (
        <div class="compare-row reveal" data-reveal-step={index}>
          <div class="compare-name">
            <span class="compare-icon"><Icon name={row.icon} size={17} /></span>
            <span>
              <strong>{row.name[locale]}</strong>
              <small>{row.note[locale]}</small>
            </span>
          </div>
          <div class="bars">
            <div class="bar without" style={`--pct:${percent(row.without, row.total)}`}>
              <span></span><em data-countup>{row.without}/{row.total}</em>
            </div>
            <div class="bar with" style={`--pct:${percent(row.with, row.total)}`}>
              <span></span><em data-countup>{row.with}/{row.total}</em>
            </div>
          </div>
        </div>
      ))}
    </div>
    <p class="compare-note">{d.compareNote[locale]}</p>

    <h3 class="routing-title">{d.factsTitle[locale]}</h3>
    <p class="section-lede">{d.factsIntro[locale]}</p>
    <div class="fact-grid">
      {d.facts.map((fact, index) => (
        <article class="fact panel-flat reveal grow" data-reveal-step={index}>
          <span class="fact-icon"><Icon name={fact.icon} size={18} /></span>
          <strong data-countup>{fact.value}</strong>
          <span class="fact-label">{fact.label[locale]}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="ev-section" aria-labelledby="cases">
    <h2 id="cases">{d.casesTitle[locale]}</h2>
    <p class="section-lede">{d.casesIntro[locale]}</p>
    <div class="case-grid">
      {d.cases.map((item, index) => (
        <article class:list={['case', item.tone, 'reveal']} data-reveal-step={index % 2}>
          <p class="case-situation"><span class="case-icon"><Icon name={item.icon} size={18} /></span>{item.situation[locale]}</p>
          <div class="case-outcome">
            <p>{item.behavior[locale]}</p>
            <em>{item.score}</em>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ev-section" aria-labelledby="scenarios">
    <h2 id="scenarios">{d.scenariosTitle[locale]}</h2>
    <p class="section-lede">{d.scenariosIntro[locale]}</p>
    <div class="panel-flat scenario-panel">
      <table>
        <thead>
          <tr>{d.scenarioColumns[locale].map((column) => <th>{column}</th>)}</tr>
        </thead>
        <tbody>
          {scenarioSnapshot.map((scenario) => (
            <tr>
              <td class="mono id">{scenario[0]}</td>
              <td>{locale === 'en' ? scenario[1] : scenario[3]}</td>
              <td class="expected"><Icon name="check" size={15} />{locale === 'en' ? scenario[2] : scenario[4]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ev-section" aria-labelledby="cost">
    <h2 id="cost">{d.costTitle[locale]}</h2>
    <p class="section-lede">{d.costIntro[locale]}</p>
    <div class="cost-grid">
      {d.costs.map((cost, index) => (
        <article class="cost panel-flat reveal grow" data-reveal-step={index}>
          <header><span class="cost-icon-small"><Icon name={cost.icon} size={17} /></span><span class="cost-delta">{cost.delta}</span></header>
          <h3>{cost.label[locale]}</h3>
          <p class="cost-numbers"><b>{cost.from}</b><Icon name="arrow" size={16} /><b class="up">{cost.to}</b></p>
        </article>
      ))}
      <article class="cost-note panel-flat">
        <span class="cost-icon"><Icon name="lock" size={20} /></span>
        <p>{d.costNote[locale]}</p>
      </article>
    </div>
  </section>

  <section class="ev-section" aria-labelledby="source">
    <h2 id="source">{d.sourceTitle[locale]}</h2>
    <p class="section-lede">{d.sourceNote[locale]}</p>
    <div class="source-panel panel-flat">
      <dl>
        <div><dt>{t.evidencePage.sourceLabels.repository}</dt><dd>{snapshotMeta.sourceRepository}</dd></div>
        <div><dt>{t.evidencePage.sourceLabels.release}</dt><dd>{snapshotMeta.sourceVersion}</dd></div>
        <div><dt>{t.evidencePage.sourceLabels.commit}</dt><dd>{snapshotMeta.sourceCommit}</dd></div>
        <div><dt>{t.evidencePage.sourceLabels.runtimeApi}</dt><dd>NONE</dd></div>
      </dl>
      <a class="button small" href={`${githubUrl}/blob/main/docs/benchmark-log.md`} target="_blank" rel="noreferrer">{t.source}<Icon name="external" size={15} /></a>
    </div>
  </section>
</SiteLayout>

<style>
  .page-heading .lede { margin-top: 14px; }
  .ev-section { padding-top: 58px; }
  .ev-section > h2 { margin-bottom: 10px; }
  .section-lede { margin: 0 0 24px; color: var(--muted); font-size: 1.02rem; line-height: 1.68; text-wrap: pretty; }

  .method-rail { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin: 0; padding: 0; list-style: none; }
  .method-rail li { position: relative; padding: 20px 22px 24px; border: 1px solid var(--line); border-top: 2px solid var(--green); border-radius: var(--radius); background: var(--panel); transition: transform .24s var(--ease-out), box-shadow .24s var(--ease-out); }
  .method-rail li:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .method-rail header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .method-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 10px; background: var(--green-soft); color: var(--green); }
  .method-num { color: color-mix(in srgb, var(--green) 45%, transparent); font-family: var(--mono); font-size: 1.4rem; font-weight: 700; letter-spacing: -.05em; }
  .method-rail h3 { margin: 14px 0 7px; font-size: 1.02rem; }
  .method-rail p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.65; }

  .compare { padding: 24px 26px 10px; }
  .compare-legend { display: flex; gap: 20px; margin-bottom: 20px; }
  .key { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-family: var(--mono); font-size: .8rem; letter-spacing: .05em; text-transform: uppercase; }
  .key i { width: 12px; height: 12px; border-radius: 3px; }
  .key.without i { background: var(--line-strong); }
  .key.with i { background: var(--green); }
  .compare-row { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 26px; align-items: center; padding: 18px 0; border-top: 1px solid var(--line); }
  .compare-name { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: center; }
  .compare-icon { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; background: var(--panel-soft); color: var(--green); }
  .compare-name strong { display: block; font-size: 1rem; line-height: 1.35; }
  .compare-name small { display: block; color: var(--muted); font-family: var(--mono); font-size: .8rem; }
  .compare-name .against { margin-top: 3px; font-family: var(--sans); font-size: .82rem; }
  .compare-note { margin: 18px 0 0; color: var(--muted); font-size: .93rem; line-height: 1.68; text-wrap: pretty; }
  .bars { display: grid; gap: 9px; }
  .bar { position: relative; display: flex; align-items: center; gap: 12px; height: 26px; border-radius: 5px; background: var(--panel-soft); }
  .bar span { display: block; height: 100%; width: 0; border-radius: 5px; transition: width 1.1s var(--ease-out) .12s; }
  .compare-row.shown .bar span { width: var(--pct); }
  .bar.without span { background: var(--line-strong); }
  .bar.with span { background: linear-gradient(90deg, var(--green), var(--green-bright)); }
  .bar em { flex: 0 0 auto; font-family: var(--mono); font-size: .84rem; font-style: normal; font-weight: 700; font-variant-numeric: tabular-nums; }
  .bar.without em { color: var(--muted); }
  .bar.with em { color: var(--green); }

  .routing-title { margin: 40px 0 16px; font-size: 1.12rem; }
  .fact-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .fact { padding: 20px 22px; transition: transform .24s var(--ease-out), border-color .24s var(--ease-out); }
  .fact:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--green) 40%, var(--line)); }
  .fact-icon { display: grid; width: 34px; height: 34px; place-items: center; margin-bottom: 14px; border-radius: 9px; background: var(--green-soft); color: var(--green); }
  .fact strong { display: block; color: var(--green); font-size: 1.9rem; line-height: 1; letter-spacing: -.05em; }
  .fact-label { display: block; margin-top: 9px; color: var(--muted); font-size: .88rem; line-height: 1.5; }

  .case-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .case { padding: 22px 24px; border: 1px solid var(--line); border-left: 3px solid var(--tone, var(--green)); border-radius: var(--radius); background: var(--panel); transition: box-shadow .24s var(--ease-out), transform .24s var(--ease-out); }
  .case:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .case.orange { --tone: var(--orange); }
  .case.purple { --tone: var(--purple); }
  .case.green { --tone: var(--green); }
  .case.blue { --tone: var(--blue); }
  .case-situation { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; margin: 0 0 18px; font-size: 1.04rem; font-weight: 650; line-height: 1.55; }
  .case-icon { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; background: color-mix(in srgb, var(--tone) 12%, transparent); color: var(--tone); }
  .case-outcome { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: start; padding: 16px 18px; border-radius: 8px; background: var(--panel-soft); }
  .case-outcome p { margin: 0; color: var(--text); font-size: .93rem; line-height: 1.66; }
  .case-outcome em { flex: 0 0 auto; color: var(--tone); font-family: var(--mono); font-size: .88rem; font-style: normal; font-weight: 700; font-variant-numeric: tabular-nums; }

  .scenario-panel { overflow: hidden; }  .scenario-panel table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .scenario-panel th { padding: 13px 18px; background: var(--panel-soft); color: var(--muted); font-family: var(--mono); font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-align: left; text-transform: uppercase; }
  .scenario-panel td { padding: 13px 18px; border-top: 1px solid var(--line); line-height: 1.55; }
  .scenario-panel tbody tr { transition: background-color .2s var(--ease-out); }
  .scenario-panel tbody tr:hover { background: var(--green-soft); }
  .scenario-panel .id { width: 70px; color: var(--muted); font-size: .8rem; }
  .expected { display: flex; align-items: center; gap: 8px; color: var(--green); }
  .expected > .icon { flex: 0 0 auto; }

  .cost-grid { display: grid; grid-template-columns: 1fr 1fr 1.5fr; gap: 18px; }
  .cost { padding: 22px 24px; }
  .cost > header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .cost-icon-small { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 9px; background: var(--panel-soft); color: var(--muted); }
  .cost-delta { display: inline-flex; padding: 4px 10px; border-radius: 5px; background: var(--orange-soft); color: var(--orange); font-family: var(--mono); font-size: .82rem; font-weight: 700; }
  .cost h3 { margin: 14px 0 10px; font-size: 1rem; }
  .cost-numbers { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--muted); font-family: var(--mono); font-size: 1.05rem; }
  .cost-numbers .up { color: var(--orange); }
  .cost-note { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start; padding: 22px 24px; border-left: 3px solid var(--green); }
  .cost-icon { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: var(--green-soft); color: var(--green); }
  .cost-note p { margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.68; }

  .limits-layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, .8fr); gap: 24px; align-items: start; }
  .source-panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px; align-items: center; padding: 12px 26px 12px 4px; }
  .source-panel dl { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; }
  .source-panel dl div { display: grid; gap: 6px; padding: 16px 22px; border-right: 1px solid var(--line); }
  .source-panel dl div:last-child { border-right: 0; }
  .source-panel dt { color: var(--muted); font-size: .8rem; }
  .source-panel dd { margin: 0; overflow-wrap: anywhere; font-family: var(--mono); font-size: .82rem; }

  @media (max-width: 1180px) {
    .method-rail, .fact-grid { grid-template-columns: 1fr 1fr; }
    .case-grid { grid-template-columns: 1fr; }
    .cost-grid { grid-template-columns: 1fr 1fr; }
    .cost-note { grid-column: 1 / -1; }
    .limits-layout { grid-template-columns: 1fr; }
    .source-panel { grid-template-columns: 1fr; gap: 0; padding: 4px 22px 22px; }
    .source-panel dl { grid-template-columns: 1fr 1fr; }
    .source-panel dl div { padding: 14px 0; border-right: 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .ev-section { padding-top: 44px; }
    .method-rail, .fact-grid, .cost-grid { grid-template-columns: 1fr; }
    .case-outcome { grid-template-columns: 1fr; gap: 10px; }
    .compare-row { grid-template-columns: 1fr; gap: 12px; }
    .compare { padding: 20px 18px 6px; }
    .scenario-panel { overflow-x: auto; }
    .scenario-panel table { min-width: 520px; }
  }
</style>
