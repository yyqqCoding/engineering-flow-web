---
import Icon from '../../../components/Icon.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import WorkflowIcon from '../../../components/WorkflowIcon.astro';
import { copy, workflows, type Locale } from '../../../data/site';
import { MAP_VIEWBOX, edgeGeometry } from '../../../lib/map-geometry.mjs';
import { locales, localizePath } from '../../../lib/routes.mjs';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale];
const e = t.workflowsPage.mapEdges;
const bySlug = Object.fromEntries(workflows.map((workflow) => [workflow.slug, workflow]));

// 节点铺满 960×680 视区：hub「开发」居中，四卫星分布四角（保持内缩边距，不贴边），六条边向心辐射
const mapNodes = [
  { slug: 'diagnose', x: 118, y: 150, r: 40, icon: 28 },
  { slug: 'handoff', x: 842, y: 150, r: 38, icon: 26 },
  { slug: 'code-design', x: 118, y: 578, r: 40, icon: 28 },
  { slug: 'develop', x: 480, y: 340, r: 58, icon: 38 },
  { slug: 'review', x: 842, y: 578, r: 40, icon: 28 },
] as const;

// 工作流节点的展示色调（与 bySlug[slug].tone 对应的 CSS 变量）
const toneColor = (slug: string) => ({
  develop: 'var(--green)',
  diagnose: 'var(--orange)',
  'code-design': 'var(--purple)',
  review: 'var(--blue)',
  handoff: 'var(--muted)',
})[slug] ?? 'var(--muted)';

// 每条连线对应源仓库一条明确的流转规则：from/to 声明端点（实线用 源色→目标色 渐变），虚线为条件流转。
// 路径不手写坐标：由两端节点位置 + offA/offB（端点沿圆周偏转角度）+ bend（法向弯曲量）推导，
// 与客户端拖拽共用 map-geometry，保证首屏与拖拽逐帧的几何完全一致。
// 向心布局下六条边都触及 hub：配对边用 ∓18° 偏转错开端点、反向弯曲 ±40 分离曲线与标签锚点；
// findings 用更大的 -52 弓向下方空区，两条单线微弯 -12 朝向上方空区
const mapEdges = [
  { from: 'code-design', to: 'develop', offA: -18, offB: -18, bend: -40, label: e.proposal, flow: true },
  { from: 'develop', to: 'code-design', offA: 18, offB: 18, bend: -40, label: e.deeper, flow: false },
  { from: 'develop', to: 'review', offA: -18, offB: -18, bend: -40, label: e.changed, flow: true },
  { from: 'review', to: 'develop', offA: 18, offB: 18, bend: -52, label: e.findings, flow: false },
  { from: 'diagnose', to: 'develop', offA: 0, offB: 0, bend: -12, label: e.undefined, flow: false },
  { from: 'develop', to: 'handoff', offA: 0, offB: 0, bend: -12, label: e.session, flow: false },
];
const nodeCircles = Object.fromEntries(mapNodes.map((node) => [node.slug, { x: node.x, y: node.y, r: node.r }]));
// 客户端按画布实际高宽比动态调整视区高度，布局以分数坐标下发（与视区尺寸解耦，持久化也存分数）
const defaultLayout = Object.fromEntries(mapNodes.map((node) => [node.slug, { fx: node.x / MAP_VIEWBOX.width, fy: node.y / MAP_VIEWBOX.height, r: node.r }]));
const renderedEdges = mapEdges.map((edge) => ({ ...edge, geom: edgeGeometry(nodeCircles[edge.from], nodeCircles[edge.to], edge) }));
---

<SiteLayout locale={locale} title={t.workflowsPage.title} description={t.workflowsPage.intro} active="workflows" wide>
  <header class="page-heading">
    <div>
      <p class="eyebrow">{t.workflowsPage.eyebrow}</p>
      <h1>{t.workflowsPage.title}</h1>
      <p class="lede">{t.workflowsPage.intro}</p>
    </div>
  </header>

  <div class="workflow-layout">
    <section class="workflow-list panel-flat" aria-label={t.workflowsPage.title}>
      {workflows.map((workflow, index) => (
        <a
          href={localizePath(locale, `workflows/${workflow.slug}`)}
          class:list={['workflow-row', workflow.tone]}
          data-link-slug={workflow.slug}
          style={`--row-i:${index}`}
        >
          <span class="workflow-icon"><WorkflowIcon slug={workflow.slug} size={26} /></span>
          <span class="workflow-copy">
            <strong>{workflow.title[locale]}</strong>
            <small>{workflow.summary[locale]}</small>
            <em class:list={['badge', workflow.tone]}>{workflow.mode[locale]}</em>
          </span>
          <Icon name="arrow" />
        </a>
      ))}
    </section>

    <section class="workflow-map">
      <header>
        <p class="eyebrow">{t.workflowsPage.map}</p>
        {/* 图例 + 复位按钮并入标题行右侧：底部不再独占横条，画布留给图形本身 */}
        <div class="map-tools">
          <div class="map-legend">
            <span><i class="solid"></i>{t.workflowsPage.mapLegendProgress}</span>
            <span><i class="dashed"></i>{t.workflowsPage.mapLegendOptional}</span>
            <span class="legend-gate"><i class="gate"><Icon name="lock" size={11} /></i>{t.detail.gate}</span>
          </div>
          <button type="button" class="map-reset" data-map-reset hidden><Icon name="refresh" size={14} />{t.workflowsPage.mapReset}</button>
        </div>
      </header>

      <div class="map-canvas">
        <svg
          class="map-svg"
          viewBox={`0 0 ${MAP_VIEWBOX.width} ${MAP_VIEWBOX.height}`}
          role="img"
          aria-label={t.workflowsPage.map}
          data-edge-config={JSON.stringify(mapEdges.map(({ from, to, offA, offB, bend, flow }) => ({ from, to, offA, offB, bend, flow })))}
          data-default-layout={JSON.stringify(defaultLayout)}
        >
          <defs>
            <marker id="map-arrow" markerWidth="9" markerHeight="9" refX="7.5" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M 0 0 L 8 4.5 L 0 9 Z" class="map-arrowhead" />
            </marker>
            {/* 实线箭头跟随目标节点色调；聚焦模式下虚线箭头切换为 --focus-tone */}
            {(['green', 'orange', 'purple', 'blue', 'slate'] as const).map((tone) => (
              <marker id={`map-arrow-${tone}`} markerWidth="9" markerHeight="9" refX="7.5" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
                <path d="M 0 0 L 8 4.5 L 0 9 Z" class="map-arrowhead" style={`fill: var(--${tone === 'slate' ? 'muted' : tone})`} />
              </marker>
            ))}
            <marker id="map-arrow-lit" markerWidth="9" markerHeight="9" refX="7.5" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M 0 0 L 8 4.5 L 0 9 Z" class="map-arrowhead" style="fill: var(--focus-tone, var(--line-strong))" />
            </marker>
            {renderedEdges.map((edge, index) => edge.flow && (
              <linearGradient id={`edge-grad-${index}`} gradientUnits="userSpaceOnUse" x1={edge.geom.sx} y1={edge.geom.sy} x2={edge.geom.ex} y2={edge.geom.ey}>
                <stop offset="0" style={`stop-color: ${toneColor(edge.from)}`} />
                <stop offset="1" style={`stop-color: ${toneColor(edge.to)}`} />
              </linearGradient>
            ))}
          </defs>

          {renderedEdges.map((edge, index) => (
            <g class:list={['map-edge-group', { dashed: !edge.flow, draw: edge.flow }]} data-edge-from={edge.from} data-edge-to={edge.to} style={`--edge-i:${index}`}>
              <path
                class="map-edge"
                d={edge.geom.d}
                marker-end={edge.flow ? `url(#map-arrow-${bySlug[edge.to].tone})` : 'url(#map-arrow)'}
                pathLength={edge.flow ? 100 : undefined}
                stroke={edge.flow ? `url(#edge-grad-${index})` : undefined}
              />
              {edge.flow && <path class="map-pulse" d={edge.geom.d} />}
              {/* 标签胶囊：rect 尺寸由 JS 按文字包围盒写入；无 JS 时 rect 宽高为 0，退化为带描边光晕的纯文字 */}
              <g class="edge-chip" transform={`translate(${edge.geom.lx} ${edge.geom.ly})`}>
                <rect />
                <text text-anchor="middle" dominant-baseline="central">{edge.label}</text>
              </g>
            </g>
          ))}

          {mapNodes.map((node) => {
            const workflow = bySlug[node.slug];
            const gated = node.slug === 'develop' || node.slug === 'diagnose';
            return (
              <g
                class:list={['map-node', workflow.tone, { hub: node.slug === 'develop' }]}
                transform={`translate(${node.x} ${node.y})`}
                data-node-slug={node.slug}
                data-tip-title={workflow.title[locale]}
                data-tip-summary={workflow.summary[locale]}
              >
                <a href={localizePath(locale, `workflows/${workflow.slug}`)} aria-label={workflow.title[locale]}>
                  <g class="node-inner">
                    <circle class="node-halo" r={node.r + 14} />
                    {node.slug === 'develop' && <circle class="node-pulse" r={node.r} />}
                    <circle class="node-circle" r={node.r} />
                    <g transform={`translate(${-node.icon / 2} ${-node.icon / 2})`}>
                      <WorkflowIcon slug={workflow.slug} size={node.icon} />
                    </g>
                    {gated && (
                      <g class="node-gate" transform={`translate(${node.r * 0.66} ${-node.r * 0.9})`}>
                        <circle r="12" />
                        <g transform="translate(-7 -7)"><Icon name="lock" size={14} /></g>
                      </g>
                    )}
                    <text class="node-title" y={node.r + 30} text-anchor="middle">{workflow.title[locale]}</text>
                  </g>
                </a>
              </g>
            );
          })}
        </svg>
        <div class="map-tip" data-map-tip aria-hidden="true"><strong></strong><small></small></div>
      </div>
    </section>

    <aside class="workflow-summary">
      <section class="panel-flat summary-card" data-spot>
        <p class="eyebrow">{t.workflowsPage.summary}</p>
        <dl>
          <div><dt><Icon name="grid" size={18} />{t.workflowsPage.active}</dt><dd data-countup>5</dd></div>
          <div><dt><Icon name="terminal" size={18} />{t.workflowsPage.explicit}</dt><dd data-countup>5</dd></div>
          <div><dt><Icon name="shield" size={18} />{t.workflowsPage.readOnly}</dt><dd data-countup>2</dd></div>
          <div><dt><Icon name="lock" size={18} />{t.workflowsPage.gated}</dt><dd data-countup>2</dd></div>
        </dl>
      </section>
      <section class="panel-flat about-card" data-spot>
        <p class="eyebrow">{t.workflowsPage.whyTitle}</p>
        <p>{t.workflowsPage.whyBody}</p>
        <a href={localizePath(locale, 'docs')}>{t.workflowsPage.details} <Icon name="arrow" size={16} /></a>
      </section>
    </aside>
  </div>
</SiteLayout>

<script>
  import { MAP_VIEWBOX, clampNode, edgeGeometry, fitViewHeight } from '../../../lib/map-geometry.mjs';
  import { onPageLife } from '../../../lib/motion.mjs';

  onPageLife(() => {
    const cleanups: Array<() => void> = [];
    const on = (element: Element | Window, event: string, handler: EventListener) => {
      element.addEventListener(event, handler);
      cleanups.push(() => element.removeEventListener(event, handler));
    };

    // 列表行与图谱节点同 slug 联动高亮；悬停同时进入聚焦模式：
    // 与该节点相连的边点亮为节点色调，无关的边和节点淡出
    const rows = [...document.querySelectorAll('[data-link-slug]')];
    const nodes = [...document.querySelectorAll('[data-node-slug]')];
    const edgeGroups = [...document.querySelectorAll('.map-edge-group')];
    const svgEl = document.querySelector('.map-svg');
    const toneVar: Record<string, string> = {
      develop: 'var(--green)', diagnose: 'var(--orange)', 'code-design': 'var(--purple)', review: 'var(--blue)', handoff: 'var(--muted)',
    };
    const pair = (slug: string, live: boolean) => {
      rows.forEach((row) => row.classList.toggle('wf-live', live && row.getAttribute('data-link-slug') === slug));
      const linked = edgeGroups.filter((group) => group.getAttribute('data-edge-from') === slug || group.getAttribute('data-edge-to') === slug);
      edgeGroups.forEach((group) => {
        const lit = live && linked.includes(group);
        group.classList.toggle('lit', lit);
        const path = group.querySelector('.map-edge');
        if (group.classList.contains('dashed') && path) {
          path.setAttribute('marker-end', lit ? 'url(#map-arrow-lit)' : 'url(#map-arrow)');
        }
      });
      nodes.forEach((node) => {
        const nodeSlug = node.getAttribute('data-node-slug') ?? '';
        const connected = nodeSlug === slug
          || linked.some((group) => group.getAttribute('data-edge-from') === nodeSlug || group.getAttribute('data-edge-to') === nodeSlug);
        node.classList.toggle('wf-live', live && nodeSlug === slug);
        node.classList.toggle('lit', live && connected);
      });
      if (svgEl instanceof SVGSVGElement) {
        svgEl.classList.toggle('focus-active', live);
        if (live) svgEl.style.setProperty('--focus-tone', toneVar[slug] ?? 'var(--green)');
      }
    };
    [...rows, ...nodes].forEach((element) => {
      const slug = element.getAttribute('data-link-slug') ?? element.getAttribute('data-node-slug') ?? '';
      on(element, 'pointerenter', () => pair(slug, true));
      on(element, 'pointerleave', () => pair(slug, false));
    });

    // 边标签胶囊：按文字实际包围盒给底板定尺寸；无 JS 时 rect 宽高为 0 不渲染，退化为纯文字
    document.querySelectorAll('.edge-chip').forEach((chip) => {
      const text = chip.querySelector('text');
      const rect = chip.querySelector('rect');
      if (!(text instanceof SVGTextElement) || !(rect instanceof SVGRectElement)) return;
      const box = text.getBBox();
      const padX = 10;
      const padY = 5;
      rect.setAttribute('x', `${box.x - padX}`);
      rect.setAttribute('y', `${box.y - padY}`);
      rect.setAttribute('width', `${box.width + padX * 2}`);
      rect.setAttribute('height', `${box.height + padY * 2}`);
      rect.setAttribute('rx', `${(box.height + padY * 2) / 2}`);
    });

    // 节点悬停摘要卡：按节点圆心的实际渲染位置定位，靠近画布顶部时翻转到下方
    const canvas = document.querySelector('.map-canvas');
    const tip = document.querySelector('[data-map-tip]');
    if (canvas instanceof HTMLElement && tip instanceof HTMLElement) {
      const tipTitle = tip.querySelector('strong');
      const tipSummary = tip.querySelector('small');
      nodes.forEach((node) => {
        on(node, 'pointerenter', () => {
          const circle = node.querySelector('.node-circle');
          if (!(circle instanceof SVGGraphicsElement) || !tipTitle || !tipSummary) return;
          const circleRect = circle.getBoundingClientRect();
          const canvasRect = canvas.getBoundingClientRect();
          const centerX = circleRect.left + circleRect.width / 2 - canvasRect.left;
          const above = circleRect.top - canvasRect.top > 96;
          tip.style.left = `${centerX}px`;
          tip.style.top = `${(above ? circleRect.top : circleRect.bottom) - canvasRect.top}px`;
          tip.classList.toggle('below', !above);
          tipTitle.textContent = node.getAttribute('data-tip-title') ?? '';
          tipSummary.textContent = node.getAttribute('data-tip-summary') ?? '';
          tip.classList.add('show');
        });
        on(node, 'pointerleave', () => tip.classList.remove('show'));
      });
    }

    // 节点自由拖拽：指针捕获 + 屏幕→viewBox 换算 + 边界钳制；每帧按共享几何模块重算全部连线。
    // 视区高度跟随画布实际高宽比（图区与左侧列表列同高）；布局以分数坐标表示并持久化，与尺寸解耦；
    // 与默认布局不一致时标题行出现复位按钮
    if (svgEl instanceof SVGSVGElement && canvas instanceof HTMLElement) {
      const edgeConfig = JSON.parse(svgEl.getAttribute('data-edge-config') ?? '[]') as Array<{ from: string; to: string; offA: number; offB: number; bend: number; flow: boolean }>;
      const defaults = JSON.parse(svgEl.getAttribute('data-default-layout') ?? '{}') as Record<string, { fx: number; fy: number; r: number }>;
      const fracs = Object.fromEntries(Object.entries(defaults).map(([slug, p]) => [slug, { fx: p.fx, fy: p.fy }]));
      // 读取持久化布局：只接受已知 slug 的 [0,1] 有限分数；损坏或旧版绝对坐标数据直接回退默认
      try {
        const saved = JSON.parse(localStorage.getItem('engineering-flow-map-layout') ?? 'null') as Record<string, { fx: number; fy: number }> | null;
        if (saved && typeof saved === 'object') {
          Object.keys(fracs).forEach((slug) => {
            const p = saved[slug];
            if (p && Number.isFinite(p.fx) && Number.isFinite(p.fy) && p.fx >= 0 && p.fx <= 1 && p.fy >= 0 && p.fy <= 1) {
              fracs[slug] = { fx: p.fx, fy: p.fy };
            }
          });
        }
      } catch { /* 损坏的布局数据忽略即可 */ }

      let viewHeight = MAP_VIEWBOX.height;
      // 分数坐标解析为当前视区下的圆（钳制在视区内）
      const resolve = (slug: string) => {
        const view = { width: MAP_VIEWBOX.width, height: viewHeight };
        const clamped = clampNode({ x: fracs[slug].fx * view.width, y: fracs[slug].fy * view.height }, defaults[slug].r, view);
        return { x: clamped.x, y: clamped.y, r: defaults[slug].r };
      };

      const resetButton = document.querySelector('[data-map-reset]');
      const isDirty = () => Object.keys(fracs).some((slug) => Math.hypot(fracs[slug].fx - defaults[slug].fx, fracs[slug].fy - defaults[slug].fy) > 0.004);
      const syncReset = () => { if (resetButton instanceof HTMLElement) resetButton.hidden = !isDirty(); };

      const toSvgPoint = (event: PointerEvent) => {
        const ctm = svgEl.getScreenCTM();
        if (!ctm) return { x: 0, y: 0 };
        const p = new DOMPoint(event.clientX, event.clientY).matrixTransform(ctm.inverse());
        return { x: p.x, y: p.y };
      };

      // 按当前布局全量重绘：节点位移 + 每条边的路径/流光/渐变端点/标签锚点
      const applyLayout = (persist: boolean) => {
        const positions = Object.fromEntries(Object.keys(fracs).map((slug) => [slug, resolve(slug)]));
        nodes.forEach((node) => {
          const p = positions[node.getAttribute('data-node-slug') ?? ''];
          if (p) node.setAttribute('transform', `translate(${p.x} ${p.y})`);
        });
        edgeGroups.forEach((group, index) => {
          const cfg = edgeConfig[index];
          if (!cfg || !positions[cfg.from] || !positions[cfg.to]) return;
          const geom = edgeGeometry(positions[cfg.from], positions[cfg.to], cfg);
          group.querySelector('.map-edge')?.setAttribute('d', geom.d);
          group.querySelector('.map-pulse')?.setAttribute('d', geom.d);
          group.querySelector('.edge-chip')?.setAttribute('transform', `translate(${geom.lx} ${geom.ly})`);
          const grad = svgEl.querySelector(`#edge-grad-${index}`);
          if (grad) {
            grad.setAttribute('x1', String(geom.sx));
            grad.setAttribute('y1', String(geom.sy));
            grad.setAttribute('x2', String(geom.ex));
            grad.setAttribute('y2', String(geom.ey));
          }
        });
        if (persist) localStorage.setItem('engineering-flow-map-layout', JSON.stringify(fracs));
        syncReset();
      };

      // 视区高度跟随画布：拖拽区域始终占满图区高度（与左侧列表列对齐）
      const fitView = () => {
        const box = canvas.getBoundingClientRect();
        if (box.width < 1 || box.height < 1) return;
        const next = fitViewHeight(box.width, box.height);
        if (next === viewHeight) return;
        viewHeight = next;
        svgEl.setAttribute('viewBox', `0 0 ${MAP_VIEWBOX.width} ${viewHeight}`);
        applyLayout(false);
      };
      const resizeObserver = new ResizeObserver(fitView);
      resizeObserver.observe(canvas);
      cleanups.push(() => resizeObserver.disconnect());

      let suppressClick = false;
      nodes.forEach((node) => {
        const slug = node.getAttribute('data-node-slug') ?? '';
        if (!fracs[slug]) return;
        let dragging = false;
        let moved = false;
        let start = { x: 0, y: 0 };
        let origin = { x: 0, y: 0 };
        on(node, 'pointerdown', (event) => {
          if (!(event instanceof PointerEvent) || event.button !== 0) return;
          dragging = true;
          moved = false;
          start = toSvgPoint(event);
          const p = resolve(slug);
          origin = { x: p.x, y: p.y };
          node.setPointerCapture(event.pointerId);
          tip?.classList.remove('show');
        });
        on(node, 'pointermove', (event) => {
          if (!dragging || !(event instanceof PointerEvent)) return;
          const p = toSvgPoint(event);
          // 6px 阈值区分点击与拖拽，保证普通点击仍然触发导航
          if (!moved && Math.hypot(p.x - start.x, p.y - start.y) < 6) return;
          moved = true;
          node.classList.add('dragging');
          const clamped = clampNode({ x: origin.x + p.x - start.x, y: origin.y + p.y - start.y }, defaults[slug].r, { width: MAP_VIEWBOX.width, height: viewHeight });
          fracs[slug] = { fx: clamped.x / MAP_VIEWBOX.width, fy: clamped.y / viewHeight };
          applyLayout(false);
        });
        const finish = () => {
          if (!dragging) return;
          dragging = false;
          node.classList.remove('dragging');
          if (!moved) return;
          moved = false;
          applyLayout(true);
          // 拖拽抬手后的那一次 click 不是导航意图，吞掉它
          suppressClick = true;
          window.setTimeout(() => { suppressClick = false; }, 0);
        };
        on(node, 'pointerup', finish);
        on(node, 'pointercancel', finish);
        const swallow = (event: Event) => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
        };
        node.addEventListener('click', swallow, true);
        cleanups.push(() => node.removeEventListener('click', swallow, true));
      });

      if (resetButton) {
        on(resetButton, 'click', () => {
          Object.keys(fracs).forEach((slug) => { fracs[slug] = { fx: defaults[slug].fx, fy: defaults[slug].fy }; });
          localStorage.removeItem('engineering-flow-map-layout');
          applyLayout(false);
        });
      }

      fitView();
      applyLayout(false);
    }

    // 连线首次进入视口时描边生长（只触发一次）
    const svg = document.querySelector('.map-svg');
    if (svg && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          svg.classList.add('shown');
          observer.disconnect();
        });
      }, { threshold: 0.35 });
      observer.observe(svg);
      cleanups.push(() => observer.disconnect());
    } else {
      svg?.classList.add('shown');
    }

    return () => cleanups.forEach((fn) => fn());
  });
</script>

