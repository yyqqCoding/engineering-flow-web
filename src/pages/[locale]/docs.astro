---
import Icon from '../../components/Icon.astro';
import Lifecycle from '../../components/Lifecycle.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { copy, githubUrl, workflows, type Locale } from '../../data/site';
import { locales, localizePath } from '../../lib/routes.mjs';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = copy[locale];
const codexInstall = `codex plugin marketplace add yyqqCoding/engineering-flow-skills\ncodex plugin add engineering-flow@engineering-flow`;
const claudeInstall = `/plugin marketplace add yyqqCoding/engineering-flow-skills\n/plugin install engineering-flow@engineering-flow`;
const quickStart = locale === 'en'
  ? `$engineering-flow:develop\nImplement customer CSV export. Inspect the repository, align the behavior, and pause at the final checkpoint.`
  : `$engineering-flow:develop\n实现客户 CSV 导出。检查仓库并对齐行为，在最终检查点暂停。`;
---

<SiteLayout locale={locale} title={t.docsPage.title} description={t.docsPage.intro} active="docs" wide>
  <div class="docs-layout">
    <aside class="docs-nav panel-flat">
      <label><Icon name="document" size={17} />{t.docsPage.title}</label>
      <nav>
        <a href="#install">01 · {t.docsPage.install}</a>
        <a href="#quick-start">02 · {t.docsPage.quickStart}</a>
        <a href="#lifecycle">03 · {t.docsPage.lifecycle}</a>
        <a href="#workflows">04 · {t.docsPage.choose}</a>
        <a href="#practices">05 · {t.docsPage.practices}</a>
      </nav>
      <a class="repo-link" href={githubUrl} target="_blank" rel="noreferrer"><Icon name="github" />Engineering Flow GitHub</a>
    </aside>

    <article class="docs-content" data-copied-label={t.docsPage.copied}>
      <header>
        <p class="eyebrow">GUIDE / {locale === 'en' ? 'ENGLISH' : '简体中文'}</p>
        <h1>{t.docsPage.title}</h1>
        <p class="lede">{t.docsPage.intro}</p>
      </header>

      <section id="install">
        <span class="section-number">01</span><h2>{t.docsPage.install}</h2><p>{t.docsPage.installHelp}</p>
        <h3>Codex CLI</h3>
        <div class="code-block"><code>{codexInstall}</code><button class="copy-button" data-copy={codexInstall} aria-label={t.docsPage.copy}><Icon name="copy" size={16} /></button></div>
        <h3>Claude Code</h3>
        <div class="code-block"><code>{claudeInstall}</code><button class="copy-button" data-copy={claudeInstall} aria-label={t.docsPage.copy}><Icon name="copy" size={16} /></button></div>
      </section>

      <section id="quick-start">
        <span class="section-number">02</span><h2>{t.docsPage.quickStart}</h2><p>{t.docsPage.quickHelp}</p>
        <div class="code-block tall"><code>{quickStart}</code><button class="copy-button" data-copy={quickStart} aria-label={t.docsPage.copy}><Icon name="copy" size={16} /></button></div>
        <div class="tip"><Icon name="lock" size={17} /><span>{locale === 'en' ? 'Reply “implement this” only after the final checkpoint is correct.' : '确认最终检查点正确后，再回复“开始实施”。'}</span></div>
      </section>

      <section id="lifecycle">
        <span class="section-number">03</span><h2>{t.docsPage.lifecycle}</h2><p>{t.docsPage.lifecycleHelp}</p>
        <div class="lifecycle-box panel-flat"><Lifecycle locale={locale} compact /></div>
      </section>

      <section id="workflows">
        <span class="section-number">04</span><h2>{t.docsPage.choose}</h2>
        <div class="docs-workflows">
          {workflows.map((workflow) => (
            <a href={localizePath(locale, `workflows/${workflow.slug}`)}>
              <Icon name={workflow.icon} size={20} />
              <span><strong>{workflow.title[locale]}</strong><small>{workflow.summary[locale]}</small></span>
              <code>{locale === 'en' ? '$' : '/'}engineering-flow:{workflow.slug}</code>
            </a>
          ))}
        </div>
      </section>

      <section id="practices">
        <span class="section-number">05</span><h2>{t.docsPage.practices}</h2>
        <ul>{t.docsPage.practicesList.map((item: string) => <li><Icon name="check" size={17} />{item}</li>)}</ul>
      </section>
    </article>

    <aside class="page-outline">
      <section class="panel-flat">
        <p class="eyebrow">{t.docsPage.onPage}</p>
        <ol>
          <li><a href="#install">{t.docsPage.install}</a></li>
          <li><a href="#quick-start">{t.docsPage.quickStart}</a></li>
          <li><a href="#lifecycle">{t.docsPage.lifecycle}</a></li>
          <li><a href="#workflows">{t.docsPage.choose}</a></li>
          <li><a href="#practices">{t.docsPage.practices}</a></li>
        </ol>
      </section>
      <section class="panel-flat quick-facts">
        <p class="eyebrow">QUICK FACTS</p>
        <p><Icon name="terminal" /><span><b>Codex + Claude</b><small>{locale === 'en' ? 'Synchronized invocation' : '同步调用语义'}</small></span></p>
        <p><Icon name="lock" /><span><b>{locale === 'en' ? 'Safe by default' : '默认安全'}</b><small>{locale === 'en' ? 'Human gates stay explicit' : '人工关卡保持明确'}</small></span></p>
        <p><Icon name="shield" /><span><b>{locale === 'en' ? 'Evidence-driven' : '证据驱动'}</b><small>{locale === 'en' ? 'Fresh verification required' : '要求新鲜验证'}</small></span></p>
      </section>
    </aside>
  </div>
</SiteLayout>

<script>
  const docsContent = document.querySelector('.docs-content');
  const copiedLabel = docsContent instanceof HTMLElement ? docsContent.dataset.copiedLabel ?? 'Copied' : 'Copied';
  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.getAttribute('data-copy') ?? '');
      button.setAttribute('aria-label', copiedLabel);
      button.classList.add('copied');
      setTimeout(() => button.classList.remove('copied'), 1200);
    });
  });
</script>

<style>
  .docs-layout { display: grid; grid-template-columns: 230px minmax(560px, 1fr) 250px; gap: 34px; align-items: start; }.docs-nav, .page-outline { position: sticky; top: 102px; }.docs-nav { padding: 16px; }.docs-nav > label { display: flex; align-items: center; gap: 7px; padding: 8px; font-weight: 700; }.docs-nav nav { display: grid; gap: 3px; margin: 12px 0 24px; }.docs-nav nav a { padding: 9px; border-left: 2px solid transparent; color: var(--muted); font-size: .75rem; }.docs-nav nav a:hover { border-color: var(--green); background: var(--green-soft); color: var(--green); }.repo-link { display: flex; align-items: center; gap: 8px; padding: 12px 8px 0; border-top: 1px solid var(--line); color: var(--green); font-size: .72rem; }
  .docs-content { min-width: 0; }.docs-content > header { padding-bottom: 28px; border-bottom: 1px solid var(--line); }.docs-content h1 { font-size: clamp(2.7rem, 4vw, 4rem); }.docs-content section { position: relative; padding: 36px 0 12px; scroll-margin-top: 90px; }.docs-content section + section { border-top: 1px solid var(--line); }.docs-content section > p { color: var(--muted); }.section-number { position: absolute; top: 40px; left: -40px; color: var(--green); font-family: var(--mono); font-size: .65rem; }.docs-content h3 { margin-top: 20px; font-size: .8rem; }.code-block.tall { min-height: 92px; }.copy-button.copied { border-color: var(--green); color: var(--green); }.tip { display: flex; align-items: center; gap: 9px; margin-top: -10px; padding: 10px 13px; border: 1px solid color-mix(in srgb, var(--green) 35%, var(--line)); border-radius: 7px; background: var(--green-soft); color: var(--green); font-size: .75rem; }.lifecycle-box { padding: 22px 14px; }
  .docs-workflows { display: grid; gap: 8px; }.docs-workflows > a { display: grid; grid-template-columns: 32px 1fr auto; gap: 10px; align-items: center; padding: 13px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel); }.docs-workflows > a:hover { border-color: var(--green); }.docs-workflows span strong, .docs-workflows span small { display: block; }.docs-workflows span small { color: var(--muted); font-size: .7rem; }.docs-workflows code { color: var(--green); font-size: .62rem; }
  .docs-content ul { display: grid; gap: 10px; padding: 0; list-style: none; }.docs-content li { display: flex; gap: 9px; color: var(--muted); }.docs-content li .icon { color: var(--green); }
  .page-outline { display: flex; flex-direction: column; gap: 16px; }.page-outline section { padding: 18px; }.page-outline ol { display: grid; gap: 8px; margin: 0; padding-left: 22px; color: var(--muted); font-size: .73rem; }.page-outline a:hover { color: var(--green); }.quick-facts > p:not(.eyebrow) { display: flex; gap: 10px; margin: 13px 0; }.quick-facts p > .icon { color: var(--green); }.quick-facts b, .quick-facts small { display: block; }.quick-facts b { font-size: .75rem; }.quick-facts small { color: var(--muted); font-size: .66rem; }
  @media (max-width: 1180px) { .docs-layout { grid-template-columns: 210px 1fr; }.page-outline { display: none; } }
  @media (max-width: 780px) { .docs-layout { grid-template-columns: 1fr; }.docs-nav { position: static; }.docs-nav nav { grid-template-columns: 1fr 1fr; }.section-number { position: static; display: block; margin-bottom: 8px; }.docs-workflows > a { grid-template-columns: 32px 1fr; }.docs-workflows code { grid-column: 2; } }
</style>
